/* Google reviews badge */
.gr-badge { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.9rem; border-radius: 999px; text-decoration: none; border: 1px solid var(--gray-200); background: #fff; transition: box-shadow var(--transition), transform var(--transition); }
.gr-badge:hover { box-shadow: var(--shadow-sm); transform: translateY(-1px); }
