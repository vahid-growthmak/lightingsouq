  align-items: center; 
  gap: 0.625rem; 
  font-size: 0.8125rem; 
  font-weight: 600; 
  color: var(--brand-text);
}
.trust-icon { color: var(--brand-primary); flex-shrink: 0; width: 24px; height: 24px; }

/* ---- Section Header ---- */
.section-header { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; }
@media (min-width: 768px) {
