  font-weight: 700;
  min-width: 2.25rem;
  text-align: center;
}
.count-sep { font-size: 1.25rem; font-weight: 700; color: var(--brand-text); }

/* ---- Product Card ---- */
.product-card {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius);
  overflow: hidden;
  transition: box-shadow var(--transition);
  display: flex;
  flex-direction: column;
}
.product-card:hover { box-shadow: var(--shadow); }
.product-img-wrap {
  position: relative;
  aspect-ratio: 1;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.product-placeholder {
  width: 6rem; height: 6rem;
  background: var(--gray-300);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-500);
  font-size: 0.8rem;
  flex-direction: column;
  gap: 0.25rem;
  text-align: center;
}
.product-badge {
  position: absolute;
  top: 0.5rem; left: 0.5rem;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.2rem 0.5rem;
  border-radius: 0.25rem;
}
.badge-sale   { background: #ef4444; }
.badge-hot    { background: #f97316; }
.badge-new    { background: #22c55e; }
.badge-best   { background: var(--brand-primary); }
.btn-wishlist {
  position: absolute;
  top: 0.5rem; right: 0.5rem;
  background: #fff;
  border-radius: 50%;
  width: 2rem; height: 2rem;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-sm);
  color: var(--gray-600);
  transition: background var(--transition);
}
.btn-wishlist:hover { background: var(--gray-100); }
/* 2rem is a 32px target. Growing the circle would unbalance the card corner, so the hit area is
   extended with a transparent overlay instead — the button looks identical, the tappable box is
   44px. Same technique below for the PDP gallery tools and the quantity stepper. */
.btn-wishlist::after {
  content: ""; position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%); width: 44px; height: 44px;
}
.product-body { padding: 1rem; flex: 1; display: flex; flex-direction: column; }
.product-type { font-size: 0.75rem; color: var(--gray-500); margin-bottom: 0.25rem; }
.product-title { font-size: 0.9rem; font-weight: 500; margin-bottom: 0.5rem; flex: 1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; min-height: 2.5em; }
.product-stars { display: flex; align-items: center; gap: 0.15rem; margin-bottom: 0.5rem; }
.star { width: 0.75rem; height: 0.75rem; }
.star-filled { color: var(--brand-secondary); fill: var(--brand-secondary); }
.star-empty  { color: var(--gray-300); fill: var(--gray-300); }
.review-count { font-size: 0.75rem; color: var(--gray-500); margin-left: 0.25rem; }
.product-price { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
.old-price { font-size: 0.875rem; color: var(--gray-400); text-decoration: line-through; }
.new-price { font-size: 1.1rem; font-weight: 600; color: var(--brand-primary); }
.btn-cart {
  width: 100%;
  background: var(--brand-accent);
  color: #fff;
  padding: 0.5rem 1rem;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  transition: background var(--transition);
}
.btn-cart:hover { background: var(--brand-primary); }

/* ---- Category Card ---- */
.category-card {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius);
  overflow: hidden;
  cursor: pointer;
  transition: border-color var(--transition), box-shadow var(--transition);
  text-align: center;
}
.category-card:hover { border-color: var(--brand-accent); box-shadow: var(--shadow-sm); }
.cat-img-wrap {
  aspect-ratio: 1;
  background: linear-gradient(135deg, var(--gray-100), var(--gray-200));
  display: flex; align-items: center; justify-content: center;
}
.cat-placeholder {
  width: 5rem; height: 5rem;
  background: var(--gray-300);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--gray-500);
  font-size: 0.75rem;
}
.cat-body { padding: 1rem; }
.cat-title { font-weight: 500; font-size: 0.9rem; margin-bottom: 0.25rem; color: var(--brand-text); transition: color var(--transition); }
.category-card:hover .cat-title { color: var(--brand-accent); }
.cat-count { font-size: 0.8rem; color: var(--gray-500); margin-bottom: 0.5rem; }
.cat-link { font-size: 0.8rem; color: var(--brand-link); }
.cat-link:hover { text-decoration: underline; }

/* ---- Space Card ---- */
.space-card {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 4/3;
  background-size: cover;
  background-position: center;
  cursor: pointer;
}
.space-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.40);
  transition: background var(--transition);
}
.space-card:hover .space-overlay { background: rgba(0,0,0,0.55); }
.space-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.5rem;
  color: #fff;
}
.space-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.25rem; }
.space-desc { font-size: 0.875rem; color: rgba(255,255,255,0.8); margin-bottom: 0.75rem; }
.btn-browse {
  align-self: flex-start;
  background: #fff;
  color: var(--brand-primary);
  padding: 0.4rem 1rem;
  border-radius: var(--radius);
  font-size: 0.875rem;
  font-weight: 600;
  transition: background var(--transition);
}
.btn-browse:hover { background: var(--gray-100); }

/* ---- Featured Banner ---- */
.featured-banner {
  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url({{ 'featured-banner.png' | asset_url }});
  background-size: cover;
  background-position: center;
  padding: 3rem 0;
  color: #fff;
}
@media (min-width: 768px) { .featured-banner { padding: 4rem 0; } }
.featured-title { font-size: clamp(1.25rem, 6vw, 2.25rem); font-weight: 700; margin-bottom: 1rem; line-height: 1.2; }
.featured-sub { font-size: 1rem; opacity: 0.9; max-width: 640px; margin: 0 auto 1.5rem; line-height: 1.5; }
.btn-secondary {
  background: var(--brand-secondary);
  color: #fff;
  padding: 0.75rem 2rem;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 600;
  transition: opacity var(--transition);
}
.btn-secondary:hover { opacity: 0.9; }

/* ---- Review Card ---- */
.review-card { background: var(--gray-50); border-radius: var(--radius); padding: 1.5rem; }
.review-stars { display: flex; gap: 0.15rem; margin-bottom: 0.5rem; }
.review-text { font-size: 0.875rem; color: var(--gray-700); margin-bottom: 0.75rem; line-height: 1.6; }
.reviewer-name { font-weight: 500; font-size: 0.875rem; }
.review-date { font-size: 0.75rem; color: var(--gray-500); }

/* ---- Product Card ---- */
.product-card {
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  height: 100%;
  border: 1px solid #f0f0f0;
}
.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}
.product-img-wrap {
  position: relative;
  aspect-ratio: 1/1;
  overflow: hidden;
  background: #f9f9f9;
}
.product-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.product-card:hover .product-img-wrap img {
  transform: scale(1.05);
}

.product-body {
  padding: 0.75rem;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
@media (min-width: 768px) {
  .product-body { padding: 1.25rem; gap: 0.5rem; }
}

.product-type {
  font-size: 0.7rem;
  text-transform: uppercase;
  color: var(--gray-500);
  font-weight: 600;
  letter-spacing: 0.02em;
}
.product-title {
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.3;
  color: var(--brand-text);
  margin-bottom: 0.25rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: 2.6em;
}
@media (min-width: 768px) {
  .product-title { font-size: 1.1rem; }
}

.product-stars { display: flex; gap: 0.1rem; margin-top: auto; }
.product-stars span { font-size: 0.8rem !important; }

.product-price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.5rem;
}
.product-price .new-price { font-weight: 700; color: var(--brand-primary); font-size: 1rem; }
.product-price .old-price { text-decoration: line-through; color: var(--gray-400); font-size: 0.85rem; }

.btn-cart {
  width: 100%;
  padding: 0.6rem;
  background: var(--brand-primary);
  color: #fff;
  border-radius: var(--radius);
  font-weight: 600;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
  transition: background 0.2s;
  cursor: pointer;
}
.btn-cart:hover { background: var(--brand-secondary); }

/* ---- Category Card ---- */
.category-card {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 1/1;
  background: var(--gray-100);
  cursor: pointer;
}
.cat-img-wrap { width: 100%; height: 100%; }
.cat-body {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 0.75rem;
  /* The title sits near the TOP of this bottom-anchored box, where the old ramp was still
     between transparent and 0.35 — fine over a calm photo, unreadable over the Smart Home tile,
     whose image is promo artwork with its own bright text. The ramp now reaches a usable value
     much sooner, so the contrast floor no longer depends on which image a collection happens to
     have. Tile images stay untouched. */
  background: linear-gradient(transparent 0%, rgba(0,0,0,0.45) 18%, rgba(0,0,0,0.72) 45%, rgba(0,0,0,0.92) 100%);
  color: #fff;
  transition: background 0.3s ease; /* BUG_03: `all` animated the box size too */
}
@media (min-width: 768px) {
  .cat-body { padding: 1.25rem; }
}
/* Belt and braces with the gradient above: a shadow travels with the glyphs, so a light patch in
   the middle of an image can't strand a word the way a fixed overlay can. */
.cat-title { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.15rem; color: #fff; line-height: 1.25; text-shadow: 0 1px 3px rgba(0,0,0,0.55); } /* BUG_03: inherited 1.5 made wrapped titles overflow small cards */
.cat-count { font-size: 0.7rem; opacity: 0.9; font-weight: 500; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,0.55); }
/* BUG_03: was display:none -> block on hover. That grew the bottom-anchored .cat-body,
   pushing the title up ~39px into the transparent part of the gradient (and display
   can't animate, so it jittered). Reserve the space and fade it in instead. */
.cat-link { display: block; margin-top: 0.5rem; font-size: 0.8rem; font-weight: 600; color: #fff; opacity: 0; transform: translateY(4px); transition: opacity 0.3s ease, transform 0.3s ease; }
.category-card:hover .cat-link, .category-card:focus-within .cat-link { opacity: 1; transform: none; }
/* whole-card links: no underline, inherit colours (card content keeps its own colours) */
a.category-card, a.side-banner, a.fc-card { text-decoration: none; cursor: pointer; }
a.category-card, a.fc-card { color: inherit; }
a.fc-card:hover { border-color: var(--brand-accent); }

/* ---- Mobile "View more" collapse (shared by category / brands / spaces / reviews) ----
   A grid that reads well on a desktop becomes an endless scroll on a phone. A section wraps its
   grid in [data-m-collapse], tags the overflow items .m-hide, and adds a .m-more-wrap button after
   it. Below 768px the tagged items stay hidden until the button is tapped. At 768px and up none of
   this applies: .m-hide items render normally and the button is display:none, so desktop is byte
   for byte what it was. One mechanism, four sections — the alternative was four copies of the same
   show/hide script. */
.m-more-wrap { display: none; }
@media (max-width: 767px) {
  [data-m-collapse]:not(.is-expanded) .m-hide { display: none !important; }
  [data-m-collapse] .m-more-wrap { display: flex; justify-content: center; margin-top: 1.25rem; }
  [data-m-collapse].is-expanded .m-more-wrap { display: none; }
  .m-more {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem;
    min-height: 44px; padding: 0.7rem 1.35rem;
    border: 1px solid var(--gray-300); border-radius: var(--radius);
    background: #fff; color: var(--brand-primary);
    font-family: inherit; font-size: 0.9rem; font-weight: 700; cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }
  .m-more:hover { border-color: var(--brand-primary); }
  .m-more .material-symbols-outlined { font-size: 1.15rem; }
}

/* ---- Grid Layouts & Gaps ---- */
.grid-2, .grid-3, .grid-4, .grid-5 {
  display: grid;
  gap: 0.75rem; /* Standard mobile gap */
}
@media (min-width: 768px) {
  .grid-2, .grid-3, .grid-4, .grid-5 { gap: 1.5rem; }
}

.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(1, 1fr); }
@media (min-width: 640px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }

.grid-4 { grid-template-columns: repeat(2, 1fr); }
@media (min-width: 1024px) { .grid-4 { grid-template-columns: repeat(4, 1fr); } }

.grid-5 { grid-template-columns: repeat(2, 1fr); }
@media (min-width: 640px) { .grid-5 { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1024px) { .grid-5 { grid-template-columns: repeat(5, 1fr); } }

/* ---- Other Sections ---- */
.review-card { background: var(--gray-50); border-radius: var(--radius); padding: 1.5rem; }
.review-stars { display: flex; gap: 0.15rem; margin-bottom: 0.5rem; }
.review-text { font-size: 0.875rem; color: var(--gray-700); margin-bottom: 0.75rem; line-height: 1.6; }
.reviewer-name { font-weight: 500; font-size: 0.875rem; }
.review-date { font-size: 0.75rem; color: var(--gray-500); }

.why-card { background: #fff; border-radius: var(--radius); padding: 1.5rem; text-align: center; box-shadow: var(--shadow-sm); }
