/* ---- Trust Strip ---- */
.trust-strip { background: #fff; border-top: 1px solid var(--gray-200); border-bottom: 1px solid var(--gray-200); padding: 1.5rem 0; }
.trust-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem 0.75rem;
}
@media (min-width: 1024px) { .trust-grid { grid-template-columns: repeat(4, 1fr); } }
.trust-item { 
