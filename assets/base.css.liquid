  .footer-col--links .footer-heading::after { content: 'expand_more'; font-family: 'Material Symbols Outlined'; font-weight: 400; font-size: 1.4rem; line-height: 1; transition: transform 0.25s ease; opacity: 0.85; }
  .footer-col--links .footer-heading[aria-expanded="true"]::after { transform: rotate(180deg); }
