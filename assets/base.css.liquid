/* ---- Mobile + tablet: collapse link columns into accordions ---- */
@media (max-width: 1023px) {
  .footer-grid { grid-template-columns: 1fr; gap: 0; }
  .footer-brand { padding-bottom: 1.25rem; }
  .footer-col--links { border-top: 1px solid rgba(255,255,255,0.14); }
