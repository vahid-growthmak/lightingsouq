}
.section-title { font-size: clamp(1.25rem, 5vw, 1.75rem); font-weight: 700; margin-bottom: 0.25rem; }
.section-sub { color: var(--gray-500); font-size: 0.875rem; }

/* ---- Countdown ---- */
.countdown-wrap { display: flex; align-items: center; gap: 0.5rem; width: 100%; }
@media (min-width: 768px) { .countdown-wrap { width: auto; } }
.countdown { display: flex; align-items: center; gap: 0.25rem; }
.count-box {
  background: var(--brand-primary);
  color: #fff;
  padding: 0.375rem 0.5rem;
