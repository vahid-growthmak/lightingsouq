{%- style -%}
  /* Boxless, premium brand logos — no cards, grayscale that colours on hover */
  /* BUG_01: min-width:auto made each card shrink-wrap its logo, so wide wordmarks
     (LEDVANCE/OSRAM) sat ~3x wider than square marks (GE/KDK) and logo centres were
     unevenly spaced. Fixed slots restore an even rhythm regardless of logo shape. */
  /* Even VISUAL spacing: fixed 180/210px slots made the logo centres even but the gaps
     the eye actually reads wildly uneven (72px-168px), because the logos range from
     33px wide (KDK) to 140px (OSRAM). Each slot now hugs its logo and one fixed gap
     separates them, so every gap between two logos is identical.
     The gap is also what keeps the marquee seamless: the strip is duplicated once and
     scrolls -50%, so each half (9 logos ~680px + 9 gaps) must stay wider than the
     1280px container. 5rem gaps give ~1400px per half. */
  #BM--{{ section.id }} .brand-marquee-inner { gap: 3rem; }
  @media (min-width: 768px) { #BM--{{ section.id }} .brand-marquee-inner { gap: 5rem; } }
  #BM--{{ section.id }} .brand-card { background: transparent; border: none; box-shadow: none; width: auto; min-width: 0; height: 84px; padding: 0; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  @media (min-width: 768px) { #BM--{{ section.id }} .brand-card { width: auto; min-width: 0; padding: 0; height: 84px; } }
  #BM--{{ section.id }} .brand-tile--marquee { width: auto; display: flex; align-items: center; justify-content: center; }
  /* explicit max-width also kills the inherited `max-width:80%` resolving against a shrink-wrapped parent */
  #BM--{{ section.id }} .brand-img { max-height: 44px; max-width: 140px; width: auto; object-fit: contain; filter: grayscale(1); opacity: 0.65; transition: filter 0.2s ease-out, opacity 0.2s ease-out; }
  #BM--{{ section.id }} .brand-card:hover .brand-img { filter: grayscale(0); opacity: 1; }
{%- endstyle -%}
<section class="featured-brands" id="BM--{{ section.id }}">
  <div class="container text-center">
    <p style="color: var(--brand-primary); font-weight:700; letter-spacing:0.1em; text-transform:uppercase; font-size:0.8rem; margin-bottom:0.5rem;">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <div class="brand-marquee-container mt-8">
      <div class="brand-marquee-inner">
        {%- comment -%} First Set {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' -%}
            <div class="brand-card" {{ block.shopify_attributes }}>
              {%- assign mq_link = block.settings.name | handleize | prepend: '/pages/' -%}{%- render 'brand-logo', name: block.settings.name, image: block.settings.image, link: mq_link, style: 'marquee' -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%} Duplicate Set for Seamless Loop {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' -%}
            <div class="brand-card" aria-hidden="true">
              {%- assign mq_link = block.settings.name | handleize | prepend: '/pages/' -%}{%- render 'brand-logo', name: block.settings.name, image: block.settings.image, link: mq_link, style: 'marquee' -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured Brands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We Work With" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Marquee",
      "blocks": [
        { "type": "logo", "settings": { "name": "Amazon" } },
        { "type": "logo", "settings": { "name": "Chink" } },
        { "type": "logo", "settings": { "name": "Glint" } },
        { "type": "logo", "settings": { "name": "Ledvance" } },
        { "type": "logo", "settings": { "name": "Vettam" } },
        { "type": "logo", "settings": { "name": "DG Lighting" } },
        { "type": "logo", "settings": { "name": "B.lux" } },
        { "type": "logo", "settings": { "name": "Insight" } },
        { "type": "logo", "settings": { "name": "Zanfi" } }
      ]
    }
  ]
}
{% endschema %}
