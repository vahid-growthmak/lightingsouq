{%- comment -%}
  Full shopping cart — OS 2.0. Line items with qty + remove, order summary,
  checkout button. Empty-cart state. Qty changes go through /cart/change.js and the
  prices repaint in place — no page reload (same behaviour as the cart drawer).
  The form + Update button remain as the no-JS / error fallback.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section class="section bg-white" id="Sec--{{ section.id }}" aria-labelledby="cart-heading">
  <div class="container">
    <div class="section-header">
      <div>
        <h1 class="section-title" id="cart-heading">{{ s.heading }}</h1>
      </div>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="lsq-cart-form" class="lsq-cart">
        <div class="lsq-cart-items">
          {%- for item in cart.items -%}
            <div class="lsq-cart-item" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="lsq-cart-thumb">
                {%- if item.image != blank -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">
                {%- endif -%}
              </a>
              <div class="lsq-cart-info">
                <a href="{{ item.url }}" class="lsq-cart-title">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}
                  <p class="lsq-cart-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="lsq-cart-price-mobile">{{ item.final_line_price | money }}</p>
              </div>
              <div class="lsq-cart-qty">
                <label class="lsq-sr-only" for="updates_{{ item.index | plus: 1 }}">{{ s.qty_label }}</label>
                {%- comment -%}
                  The bare number input relied on the browser's own spinners, which phones do not
                  show - so on mobile there was no way to change quantity except typing. Same
                  minus / input / plus stepper as the product page and cart drawer. Buttons are
                  type="button" so they never submit the form themselves; stepping is debounced
                  into one cart update (see script below).
                {%- endcomment -%}
                <div class="lsq-qty-stepper">
                  <button type="button" class="lsq-qty-btn" data-step="-1" aria-label="{{ s.qty_minus_label }}">&minus;</button>
                  <input type="number" min="0" name="updates[]" id="updates_{{ item.index | plus: 1 }}" value="{{ item.quantity }}" inputmode="numeric" class="lsq-qty-input">
                  <button type="button" class="lsq-qty-btn" data-step="1" aria-label="{{ s.qty_plus_label }}">+</button>
                </div>
                {%- comment -%} BUG_18: was a "Remove" text link in the info column; now an icon beside the qty {%- endcomment -%}
                <a href="{{ item.url_to_remove }}" class="lsq-cart-remove" aria-label="{{ s.remove_label }}" title="{{ s.remove_label }}"><span class="material-symbols-outlined">delete</span></a>
              </div>
              <div class="lsq-cart-line-price">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        <div class="lsq-cart-summary">
          <div class="lsq-cart-summary-row">
            <span>{{ s.subtotal_label }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="section-sub">{{ s.tax_note }}</p>
          <button type="submit" name="checkout" class="btn-primary lsq-checkout-btn">{{ s.checkout_label }}</button>
          <button type="submit" name="update" class="btn-outline lsq-update-btn">{{ s.update_label }}</button>
          <a href="{{ s.continue_link | default: routes.all_products_collection_url }}" class="btn-ghost lsq-continue">{{ s.continue_label }}</a>
        </div>
      </form>
    {%- else -%}
      <div class="lsq-cart-empty text-center">
        <p class="section-sub" style="margin-bottom:1.25rem;">{{ s.empty_text }}</p>
        <a href="{{ s.empty_link | default: routes.all_products_collection_url }}" class="btn-primary">{{ s.empty_button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #Sec--{{ section.id }} .lsq-cart { display:grid; grid-template-columns:1fr; gap:2rem; }
  @media (min-width:900px){ #Sec--{{ section.id }} .lsq-cart { grid-template-columns:2fr 1fr; align-items:start; } }
  #Sec--{{ section.id }} .lsq-cart-item {
    display:grid; grid-template-columns:88px 1fr auto; gap:1rem; align-items:center;
    padding:1rem 0; border-bottom:1px solid var(--gray-200,#e5e7eb);
  }
  #Sec--{{ section.id }} .lsq-cart-thumb img { width:88px; height:88px; object-fit:cover; border-radius:var(--radius,8px); }
  #Sec--{{ section.id }} .lsq-cart-title { font-weight:600; color:var(--brand-text); text-decoration:none; }
  #Sec--{{ section.id }} .lsq-cart-variant { color:var(--gray-500); font-size:0.875rem; margin-top:0.15rem; }
  #Sec--{{ section.id }} .lsq-cart-price-mobile { display:none; }
  #Sec--{{ section.id }} .lsq-cart-qty { display:flex; align-items:center; gap:0.5rem; }
  #Sec--{{ section.id }} .lsq-cart-remove { display:inline-flex; align-items:center; margin-top:0; color:var(--gray-500,#6b7280); transition:color 0.15s ease-out; }
  #Sec--{{ section.id }} .lsq-cart-remove:hover { color:#dc2626; }
  #Sec--{{ section.id }} .lsq-cart-remove .material-symbols-outlined { font-size:1.25rem; }
  #Sec--{{ section.id }} .lsq-qty-stepper {
    display:inline-flex; align-items:center; border:1px solid var(--gray-200,#e5e7eb);
    border-radius:var(--radius,8px); background:#fff; overflow:hidden;
  }
  #Sec--{{ section.id }} .lsq-qty-btn {
    width:44px; height:44px; display:inline-flex; align-items:center; justify-content:center;
    border:0; background:transparent; font-size:1.15rem; font-weight:600; line-height:1;
    color:var(--brand-text,#111827); cursor:pointer; transition:background 0.15s ease-out;
  }
  #Sec--{{ section.id }} .lsq-qty-btn:hover { background:var(--gray-50,#f9fafb); }
  #Sec--{{ section.id }} .lsq-qty-btn:active { background:var(--gray-100,#f3f4f6); }
  #Sec--{{ section.id }} .lsq-qty-input {
    width:44px; height:44px; padding:0; text-align:center; border:0; background:transparent;
    font-weight:600; appearance:textfield; -moz-appearance:textfield;
  }
  #Sec--{{ section.id }} .lsq-qty-input::-webkit-outer-spin-button,
  #Sec--{{ section.id }} .lsq-qty-input::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
  #Sec--{{ section.id }} .lsq-cart-item.is-busy .lsq-cart-line-price,
  #Sec--{{ section.id }} .lsq-cart-item.is-busy .lsq-cart-price-mobile { opacity:0.45; }
  #Sec--{{ section.id }} .lsq-cart.is-busy .lsq-cart-summary-row strong { opacity:0.45; }
  #Sec--{{ section.id }} .lsq-cart-line-price { font-weight:700; text-align:right; }
  #Sec--{{ section.id }} .lsq-cart-summary {
    background:var(--gray-50,#f9fafb); border:1px solid var(--gray-200,#e5e7eb);
    border-radius:var(--radius,8px); padding:1.5rem; display:flex; flex-direction:column; gap:0.75rem;
  }
  #Sec--{{ section.id }} .lsq-cart-summary-row { display:flex; justify-content:space-between; font-size:1.125rem; }
  #Sec--{{ section.id }} .lsq-checkout-btn, #Sec--{{ section.id }} .lsq-update-btn, #Sec--{{ section.id }} .lsq-continue { width:100%; text-align:center; }
  #Sec--{{ section.id }} .lsq-cart-empty { padding:3rem 0; }
  #Sec--{{ section.id }} .lsq-sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media (max-width:640px){
    #Sec--{{ section.id }} .lsq-cart-item { grid-template-columns:72px 1fr; }
    #Sec--{{ section.id }} .lsq-cart-thumb img { width:72px; height:72px; }
    #Sec--{{ section.id }} .lsq-cart-line-price { display:none; }
    #Sec--{{ section.id }} .lsq-cart-price-mobile { display:block; font-weight:700; margin-top:0.35rem; }
    #Sec--{{ section.id }} .lsq-cart-qty { grid-column:2; }
  }
{% endstyle %}

<script>
  (function () {
    var form = document.getElementById('lsq-cart-form');
    if (!form) return;
    // Must emit the same markup Liquid's money filter emits (the ht-money span), or the
    // currency selector app skips these prices and the page mixes converted and unconverted
    // currencies after a quantity change - see the matching helper in store-scripts.liquid.
    var SHOP_CURRENCY = {{ shop.currency | json }};
    var MONEY_FORMAT = {{ shop.money_format | json }};
    function moneyDigits(cents, token) {
      var dec = token.indexOf('no_decimals') > -1 ? 0 : 2;
      var comma = token.indexOf('comma_separator') > -1;
      var space = token.indexOf('space_separator') > -1;
      var thou = comma ? '.' : (space ? ' ' : ',');
      var dsep = comma ? ',' : '.';
      var n = (cents / 100) || 0;
      var parts = Math.abs(n).toFixed(dec).split('.');
      var ip = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thou);
      return (n < 0 ? '-' : '') + ip + (dec ? dsep + parts[1] : '');
    }
    function money(cents, code) {
      if (!code || code === SHOP_CURRENCY) {
        return MONEY_FORMAT.replace(/\{\{\s*(amount[a-z_]*)\s*\}\}/g, function (_, t) { return moneyDigits(cents, t); });
      }
      return code + ' ' + moneyDigits(cents, 'amount');
    }
    function fallbackSubmit() {
      var btn = form.querySelector('.lsq-update-btn');
      if (btn) btn.click(); else form.submit();
    }
    var desired = {}, timer = null, inflight = false;
    function paint(cart) {
      form.querySelectorAll('.lsq-cart-item[data-line]').forEach(function (row) {
        var it = cart.items[parseInt(row.getAttribute('data-line'), 10) - 1];
        if (!it) return;
        var input = row.querySelector('.lsq-qty-input');
        // server truth (e.g. stock caps the quantity) - but never fight the user mid-typing
        if (input && document.activeElement !== input) input.value = it.quantity;
        var lp = row.querySelector('.lsq-cart-line-price');
        if (lp) lp.innerHTML = money(it.final_line_price, cart.currency);
        var mp = row.querySelector('.lsq-cart-price-mobile');
        if (mp) mp.innerHTML = money(it.final_line_price, cart.currency);
        row.classList.remove('is-busy');
      });
      var sub = form.querySelector('.lsq-cart-summary-row strong');
      if (sub) sub.innerHTML = money(cart.total_price, cart.currency);
      form.classList.remove('is-busy');
      document.querySelectorAll('[data-cart-count]').forEach(function (el) { el.textContent = cart.item_count; });
    }
    // One line per request (that is all /cart/change.js accepts); the desired map coalesces a
    // burst of taps into the final value, so N taps cost one request per touched line.
    function flush() {
      if (inflight) return;
      var lines = Object.keys(desired);
      if (!lines.length) return;
      var line = lines[0], qty = desired[line];
      delete desired[line];
      inflight = true;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ line: parseInt(line, 10), quantity: qty })
      }).then(function (r) {
        if (!r.ok) throw new Error(r.status);
        return r.json();
      }).then(function (cart) {
        inflight = false;
        if (Object.keys(desired).length) flush();
        else paint(cart);
      }).catch(function () {
        inflight = false;
        fallbackSubmit(); // one classic round-trip beats showing a cart the server rejected
      });
    }
    function schedule(row, qty, delay) {
      desired[row.getAttribute('data-line')] = qty;
      row.classList.add('is-busy');
      form.classList.add('is-busy');
      clearTimeout(timer);
      timer = setTimeout(flush, delay);
    }
    form.querySelectorAll('.lsq-qty-input').forEach(function (input) {
      input.addEventListener('change', function () {
        var row = input.closest('.lsq-cart-item');
        if (!row) return;
        var v = parseInt(input.value, 10);
        if (!(v >= 1)) {
          // typed 0 (or junk): removing a line renumbers the others, so let the classic
          // form round-trip rebuild the page
          fallbackSubmit();
          return;
        }
        schedule(row, v, 250);
      });
    });
    form.querySelectorAll('.lsq-qty-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = btn.parentElement.querySelector('.lsq-qty-input');
        var row = btn.closest('.lsq-cart-item');
        if (!input || !row) return;
        var v = (parseInt(input.value, 10) || 0) + (parseInt(btn.getAttribute('data-step'), 10) || 0);
        if (v < 1) v = 1; // the trash icon is the remove path, minus never deletes the line
        if (String(v) === input.value) return; // minus at 1: nothing to change, no request
        input.value = v;
        schedule(row, v, 450);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "tax_note", "label": "Tax note", "default": "Taxes and shipping calculated at checkout." },
    { "type": "text", "id": "qty_label", "label": "Quantity label", "default": "Quantity" },
    { "type": "text", "id": "qty_minus_label", "label": "Decrease quantity label", "default": "Decrease quantity" },
    { "type": "text", "id": "qty_plus_label", "label": "Increase quantity label", "default": "Increase quantity" },
    { "type": "text", "id": "remove_label", "label": "Remove label", "default": "Remove" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" },
    { "type": "text", "id": "update_label", "label": "Update button", "default": "Update cart" },
    { "type": "text", "id": "continue_label", "label": "Continue link", "default": "Continue shopping" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "default": "Your cart is empty right now." },
    { "type": "text", "id": "empty_button_label", "label": "Empty button label", "default": "Start shopping" },
    { "type": "url", "id": "continue_link", "label": "Continue shopping link" },
    { "type": "url", "id": "empty_link", "label": "Empty cart button link" }
  ],
  "presets": [
    { "name": "Cart" }
  ]
}
{% endschema %}
