{%- comment -%}
  Main collection (PLP) — universal template for All Products, by-type, by-brand and
  deal collections. Real Shopify data: collection.title/description, storefront
  filters (Search & Discovery), sort, pagination, product grid. Editable SEO content
  + cross-links. Reuses base.css collection classes + the product-card snippet.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_filters = false
  if s.show_filters and collection.filters.size > 0
    assign has_filters = true
  endif
-%}

<div class="collection-header">
  <div class="container">
    <h1 class="collection-title">{{ collection.title | default: 'Products' }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-intro">{{ collection.description }}</div>
    {%- elsif s.intro_fallback != blank -%}
      <p class="collection-intro">{{ s.intro_fallback }}</p>
    {%- endif -%}
  </div>
</div>

<section class="section" style="padding-top:1rem;" id="Coll--{{ section.id }}">
  <div class="container">
    {%- paginate collection.products by s.per_page -%}
    {%- if has_filters -%}
      <button class="mobile-filter-toggle" type="button" data-filter-toggle>
        <span class="material-symbols-outlined" style="font-size:1.2rem;">tune</span> {{ section.settings.label_filters | default: 'Filters' | escape }}
      </button>
    {%- endif -%}

    <div class="collection-layout" style="margin-top:1rem;">
      {%- if has_filters -%}
        <aside class="filter-rail rail-collapsed" id="FilterRail--{{ section.id }}" aria-label="Product filters">
          <form method="get">
            {%- comment -%} Preserve active list-filter selections and sorting when the price form submits {%- endcomment -%}
            {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
            {%- for f in collection.filters -%}
              {%- if f.type == 'list' or f.type == 'boolean' -%}
                {%- for v in f.active_values -%}
                  <input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            <div class="filter-rail-head">
              <h2>{{ section.settings.label_filters | default: 'Filters' | escape }}</h2>
              <a class="filter-clear" href="{{ collection.url }}">{{ section.settings.label_clear_all | default: 'Clear all' | escape }}</a>
            </div>
            {%- for filter in collection.filters -%}
              {%- liquid
                comment
                  Open a group when it has an active selection, otherwise only the first two by default.
                endcomment
                assign fg_open = false
                if forloop.index <= 2
                  assign fg_open = true
                endif
                if filter.active_values.size > 0
                  assign fg_open = true
                endif
                if filter.type == 'price_range'
                  if filter.min_value.value != blank or filter.max_value.value != blank
                    assign fg_open = true
                  endif
                endif
              -%}
              <details class="filter-group"{% if fg_open %} open{% endif %}>
                <summary class="filter-group-title">
                  <span>{{ filter.label }}{% if filter.active_values.size > 0 %} <span class="filter-active-dot">{{ filter.active_values.size }}</span>{% endif %}</span>
                  <span class="material-symbols-outlined fg-chevron">expand_more</span>
                </summary>
                <div class="filter-values{% if filter.values.size > 8 %} filter-values-scroll{% endif %}">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    {%- for value in filter.values -%}
                      <a class="filter-option" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}" rel="nofollow">
                        <span class="material-symbols-outlined" style="font-size:1.05rem;color:{% if value.active %}var(--brand-primary){% else %}var(--gray-300,#d1d5db){% endif %};">{% if value.active %}check_box{% else %}check_box_outline_blank{% endif %}</span>
                        {{ value.label }} <span class="filter-count">{{ value.count }}</span>
                      </a>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    {%- liquid
                      comment
                        Money values are numeric subunits (cents) - divide by 100.
                        Never parse formatted money strings: the store money format
                        uses European separators (18.200,00) which breaks parsing.
                      endcomment
                      assign ps_max = filter.range_max | divided_by: 100.0 | ceil
                      assign ps_min_val = 0
                      if filter.min_value.value != blank
                        assign ps_min_val = filter.min_value.value | divided_by: 100.0 | floor
                      endif
                      assign ps_max_val = ps_max
                      if filter.max_value.value != blank
                        assign ps_max_val = filter.max_value.value | divided_by: 100.0 | ceil
                      endif
                    -%}
                    <div class="price-slider" data-price-slider data-ps-cap="{{ ps_max }}" data-ps-currency="{{ cart.currency.iso_code }}" data-ps-money-format="{{ shop.money_format | escape }}">
                      <div class="ps-track"><div class="ps-fill" data-ps-fill></div></div>
                      <input type="range" class="ps-range" data-ps-lo min="0" max="{{ ps_max }}" step="1" value="{{ ps_min_val }}" aria-label="Minimum price">
                      <input type="range" class="ps-range" data-ps-hi min="0" max="{{ ps_max }}" step="1" value="{{ ps_max_val }}" aria-label="Maximum price">
                      <div class="ps-labels"><span data-ps-lo-label></span><span data-ps-hi-label></span></div>
                      <input type="hidden" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value != blank %}{{ ps_min_val }}{% endif %}" data-ps-lo-field {% if filter.min_value.value == blank %}disabled{% endif %}>
                      <input type="hidden" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value != blank %}{{ ps_max_val }}{% endif %}" data-ps-hi-field {% if filter.max_value.value == blank %}disabled{% endif %}>
                      <button type="submit" class="btn-primary-sm" style="margin-top:0.75rem;width:100%;">{{ section.settings.label_apply | default: 'Apply' | escape }}</button>
                    </div>
                {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </form>
        </aside>
      {%- endif -%}

      <div class="collection-main">
        <div class="collection-toolbar">
          <p class="result-count"><strong>{{ collection.products_count }}</strong> {{ section.settings.label_products_word | default: 'products' | escape }}</p>
          {%- if collection.sort_options.size > 0 -%}
            <div class="sort-wrap">
              <label for="Sort--{{ section.id }}">{{ section.settings.label_sort | default: 'Sort' | escape }}</label>
              <select class="sort-select" id="Sort--{{ section.id }}" data-sort>
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                {%- for opt in collection.sort_options -%}
                  <option value="{{ opt.value }}"{% if opt.value == sort_by %} selected{% endif %}>{{ opt.name }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        </div>

        {%- if has_filters and collection.filters != empty -%}
          <div class="active-chips">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <span class="active-chip">{{ value.label }} <a href="{{ value.url_to_remove }}" aria-label="Remove {{ value.label }}"><span class="material-symbols-outlined">close</span></a></span>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if collection.products.size > 0 -%}
          <div class="grid-4">
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}<a class="page-btn" href="{{ paginate.previous.url }}" aria-label="Previous">‹</a>{%- else -%}<button class="page-btn" disabled aria-label="Previous">‹</button>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a class="page-btn" href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}<button class="page-btn active">{{ part.title }}</button>
                {%- else -%}<span class="page-btn">{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a class="page-btn" href="{{ paginate.next.url }}" aria-label="Next">›</a>{%- else -%}<button class="page-btn" disabled aria-label="Next">›</button>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div style="padding:3rem 0;display:flex;flex-direction:column;align-items:center;gap:1.25rem;text-align:center;color:var(--gray-500);">
            <p style="margin:0;">{{ section.settings.empty_title | default: 'No products found' | escape }}{% if collection.all_products_count > 0 %} {{ section.settings.empty_subtitle | default: 'with these filters' | escape }}{% endif %}.</p>
            <a class="btn-primary" href="{{ collection.url | default: routes.all_products_collection_url }}" style="display:inline-flex;align-items:center;">{{ section.settings.empty_button | default: 'View all products' | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- endpaginate -%}
  </div>
</section>

{%- if s.seo_content != blank -%}
  <section class="section bg-gray">
    <div class="container"><div class="lsq-prose">{{ s.seo_content }}</div></div>
  </section>
{%- endif -%}

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};
    var root = document.getElementById('Coll--' + SECTION_ID);
    if (!root) return;

    function rail()   { return document.getElementById('FilterRail--' + SECTION_ID); }
    function layout() { return root.querySelector('.collection-layout'); }
    function main()   { return root.querySelector('.collection-main'); }

    /* ---- Price range slider (dual thumbs) — re-bound after every swap ---- */
    function initPriceSlider() {
      var r = rail();
      var ps = r ? r.querySelector('[data-price-slider]') : null;
      if (!ps) return;
      var cap = parseInt(ps.getAttribute('data-ps-cap'), 10) || 0;
      var cur = ps.getAttribute('data-ps-currency') || '';
      var lo = ps.querySelector('[data-ps-lo]'), hi = ps.querySelector('[data-ps-hi]');
      var loF = ps.querySelector('[data-ps-lo-field]'), hiF = ps.querySelector('[data-ps-hi-field]');
      var loL = ps.querySelector('[data-ps-lo-label]'), hiL = ps.querySelector('[data-ps-hi-label]');
      var fill = ps.querySelector('[data-ps-fill]');
      if (!lo || !hi) return;
      /* The slider used to print a bare "QAR 1,234" string. Every other price on the
         site is rendered through shop.money_format, which wraps it in the markup the
         currency app looks for — so those converted and the slider labels did not,
         leaving the filter showing QAR after the shopper changed currency. Build the
         labels from the same format so they are treated identically. */
      var moneyFmt = ps.getAttribute('data-ps-money-format') || '';
      function amountStr(v, token) {
        var dec = token.indexOf('no_decimals') > -1 ? 0 : 2;
        var comma = token.indexOf('comma_separator') > -1;
        var space = token.indexOf('space_separator') > -1;
        var thou = comma ? '.' : (space ? ' ' : ',');
        var dsep = comma ? ',' : '.';
        var n = Number(v) || 0;
        var parts = Math.abs(n).toFixed(dec).split('.');
        var ip = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thou);
        return (n < 0 ? '-' : '') + ip + (dec ? dsep + parts[1] : '');
      }
      function fmt(v) {
        if (!moneyFmt) return cur + ' ' + Number(v).toLocaleString();
        return moneyFmt.replace(/\{\{\s*(amount[a-z_]*)\s*\}\}/g, function (_, token) { return amountStr(v, token); });
      }

      /* The currency app rewrites our price labels in place, but it skips an amount of
         exactly zero - so after switching currency the maximum read e.g. "396,62 OMR"
         while the minimum was still stuck on "QAR 0,00". When we can see the app has
         rewritten the maximum but left our minimum untouched, mirror the maximum's
         currency presentation onto the minimum with a zero amount. App-agnostic: in the
         base currency nothing is rewritten, so both checks fail and this is a no-op. */
      var ourLo = '', ourHi = '';
      function zeroLike(sample) {
        var m = sample.match(/([.,])(\d+)$/);
        return m ? '0' + m[1] + new Array(m[2].length + 1).join('0') : '0';
      }
      function mirrorZeroCurrency() {
        if (parseInt(lo.value, 10) !== 0) return;              /* only the exact-zero case */
        var hiTxt = hiL.textContent.trim(), loTxt = loL.textContent.trim();
        if (!ourHi || hiTxt === ourHi) return;                 /* app has not converted yet */
        if (loTxt !== ourLo) return;                           /* minimum already converted */
        var parts = hiTxt.match(/^(\D*)([\d][\d.,\s]*?)(\D*)$/);
        if (!parts) return;
        var target = loL.querySelector('.ht-money') || loL;
        target.textContent = parts[1] + zeroLike(parts[2].trim()) + parts[3];
      }
      function scheduleZeroMirror() {
        [300, 900, 2000].forEach(function (d) { setTimeout(mirrorZeroCurrency, d); });
      }
      function sync(moved) {
        var a = parseInt(lo.value, 10), b = parseInt(hi.value, 10);
        if (a > b) { if (moved === lo) { hi.value = a; b = a; } else { lo.value = b; a = b; } }
        loL.innerHTML = fmt(a); hiL.innerHTML = fmt(b); /* format carries the price markup */
        ourLo = loL.textContent.trim(); ourHi = hiL.textContent.trim();
        scheduleZeroMirror();
        if (fill && cap > 0) { fill.style.left = (a / cap * 100) + '%'; fill.style.right = (100 - b / cap * 100) + '%'; }
        loF.value = a; hiF.value = b;
        loF.disabled = (a <= 0); hiF.disabled = (b >= cap);
      }
      lo.addEventListener('input', function () { sync(lo); });
      hi.addEventListener('input', function () { sync(hi); });
      lo.addEventListener('change', function () { submitFilterForm(ps.closest('form')); });
      hi.addEventListener('change', function () { submitFilterForm(ps.closest('form')); });
      sync();
    }

    function submitFilterForm(form) {
      if (!form) return;
      var params = new URLSearchParams(new FormData(form));
      var u = new URL(location.pathname, location.origin);
      params.forEach(function (v, k) { if (v !== '') u.searchParams.append(k, v); });
      u.searchParams.delete('page');
      go(u.toString(), true, true);
    }

    /* ---- BUG_07: filter/sort/paginate without a page reload, so the scroll position
       and (crucially on mobile) the open filter panel both survive. Any failure falls
       back to a normal navigation, so filtering still works if fetch is blocked. ---- */
    var busy = false;
    function go(url, keepScroll, push) {
      if (busy) return;
      busy = true;
      var lay = layout(); if (lay) lay.classList.add('is-filtering');
      var railOpen = !!(rail() && !rail().classList.contains('rail-collapsed'));
      var target = new URL(url, location.origin);
      var fetchUrl = new URL(target.toString());
      fetchUrl.searchParams.set('section_id', SECTION_ID);
      fetch(fetchUrl.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (res) { if (!res.ok) throw new Error('status ' + res.status); return res.text(); })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var newRoot = doc.getElementById('Coll--' + SECTION_ID);
          if (!newRoot) throw new Error('section not in response');
          var newMain = newRoot.querySelector('.collection-main');
          var newRail = newRoot.querySelector('#FilterRail--' + SECTION_ID);
          var curMain = main(), curRail = rail();
          if (newMain && curMain) curMain.innerHTML = newMain.innerHTML;
          if (newRail && curRail) {
            curRail.innerHTML = newRail.innerHTML;
            curRail.classList.toggle('rail-collapsed', !railOpen);
          }
          if (push !== false) history.pushState({ lsqColl: true }, '', target.toString());
          initPriceSlider();
          if (!keepScroll) {
            var top = root.getBoundingClientRect().top + window.pageYOffset - 90;
            window.scrollTo(0, Math.max(0, top));
          }
        })
        .catch(function () { window.location.href = target.toString(); })
        .then(function () {
          busy = false;
          var l = layout(); if (l) l.classList.remove('is-filtering');
        });
    }

    /* Delegated on root, which is never replaced, so handlers survive every swap. */
    root.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest('a');
      if (!a || !root.contains(a) || a.target === '_blank') return;
      var isFilter = !!(a.matches('.filter-option, .filter-clear') || a.closest('.active-chip'));
      var isPage   = !!a.closest('.pagination');
      if (!isFilter && !isPage) return;
      var href = a.getAttribute('href');
      if (!href || href.charAt(0) === '#') return;
      e.preventDefault();
      go(href, isFilter, true);   /* filters keep your place; pagination scrolls to the top of results */
    });

    root.addEventListener('change', function (e) {
      var sel = e.target.closest('[data-sort]');
      if (!sel) return;
      var u = new URL(location.href);
      u.searchParams.set('sort_by', sel.value);
      u.searchParams.delete('page');
      go(u.toString(), true, true);
    });

    root.addEventListener('submit', function (e) {
      var form = e.target.closest('.filter-rail form');
      if (!form) return;
      e.preventDefault();
      submitFilterForm(form);
    });

    var toggle = root.querySelector('[data-filter-toggle]');
    if (toggle) toggle.addEventListener('click', function () {
      var r = rail(); if (r) r.classList.toggle('rail-collapsed');
    });

    window.addEventListener('popstate', function () { go(location.href, true, false); });

    initPriceSlider();
  })();
</script>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_filters", "label": "Show filter rail", "default": true },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "text", "id": "intro_fallback", "label": "Intro fallback (if collection has no description)", "default": "Browse our range. Use the filters to narrow by brand, base, wattage and colour temperature." },
    { "type": "header", "content": "Labels / text" },
    { "type": "text", "id": "label_filters", "label": "Filters label", "default": "Filters" },
    { "type": "text", "id": "label_clear_all", "label": "Clear all label", "default": "Clear all" },
    { "type": "text", "id": "label_apply", "label": "Price filter apply button", "default": "Apply" },
    { "type": "text", "id": "label_sort", "label": "Sort label", "default": "Sort" },
    { "type": "text", "id": "label_products_word", "label": "Products count word", "default": "products" },
    { "type": "text", "id": "empty_title", "label": "Empty state title", "default": "No products found" },
    { "type": "text", "id": "empty_subtitle", "label": "Empty state subtitle (filtered)", "default": "with these filters" },
    { "type": "text", "id": "empty_button", "label": "Empty state button", "default": "View all products" },
    { "type": "header", "content": "SEO / cross-links (optional)" },
    { "type": "richtext", "id": "seo_content", "label": "SEO content", "default": "<p>Shop lighting for every space in Qatar with same-day Doha delivery and secure checkout.</p>" }
  ],
  "presets": [
    { "name": "Collection" }
  ]
}
{% endschema %}
