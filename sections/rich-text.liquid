{%- liquid
  assign bg = section.settings.bg
  comment
    When policy_source is set, this section renders the matching policy straight from
    Settings > Policies, so Shopify is the single source of truth: editing the policy there
    updates this page with no theme change and no second copy to keep in sync. It also means
    the page and what checkout / Google Merchant Center read can never drift apart.
    Falls back to the page body, then to the section's own text, so the page still reads
    correctly while a policy is empty.
  endcomment
  assign policy_body = blank
  case section.settings.policy_source
    when 'privacy'
      assign policy_body = shop.privacy_policy.body
    when 'terms'
      assign policy_body = shop.terms_of_service.body
    when 'refund'
      assign policy_body = shop.refund_policy.body
    when 'shipping'
      assign policy_body = shop.shipping_policy.body
  endcase
-%}
<section class="section {{ bg }}" id="RT--{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="lsq-prose{% if section.settings.heading != blank %} mt-8{% endif %}">
      {% if policy_body != blank %}{{ policy_body }}{% elsif page.content != blank %}{{ page.content }}{% else %}{{ section.settings.content }}{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich Text",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select", "id": "policy_source", "label": "Pull content from a Shopify policy",
      "info": "Renders the policy from Settings > Policies so it stays in sync automatically. Falls back to this page's content while that policy is empty.",
      "options": [
        { "value": "none", "label": "None - use page content" },
        { "value": "privacy", "label": "Privacy policy" },
        { "value": "terms", "label": "Terms of service" },
        { "value": "refund", "label": "Refund policy" },
        { "value": "shipping", "label": "Shipping policy" }
      ],
      "default": "none"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content (used when the page has no body content)",
      "default": "<p>Add your content here. When this page has body content in the admin, that content is shown automatically instead of this placeholder.</p>"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "bg-white", "label": "White" },
        { "value": "bg-gray", "label": "Gray" }
      ],
      "default": "bg-white"
    }
  ],
  "presets": [
    { "name": "Rich Text" }
  ]
}
{% endschema %}
