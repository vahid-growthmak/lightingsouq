{%- comment -%}
  .grid-3 is a SINGLE column on a phone, so five full-bleed space cards stacked to a very long
  scroll. Only the first `mobile_limit` render below 768px; "View more" reveals the rest. Desktop
  keeps all of them in the 2/3-column grid.
{%- endcomment -%}
{%- liquid
  assign sp_total = 0
  for b in section.blocks
    if b.type == 'space'
      assign sp_total = sp_total | plus: 1
    endif
  endfor
  assign m_limit = section.settings.mobile_limit | default: 2
  assign sp_i = 0
-%}
<section class="section {{ section.settings.bg }}">
  <div class="container">
    <h2 class="section-title text-center">{{ section.settings.heading }}</h2>
    {%- if section.settings.intro != blank -%}<p class="section-sub text-center">{{ section.settings.intro }}</p>{%- endif -%}
    <div data-m-collapse>
    <div class="grid-3 mt-8">
      {%- for block in section.blocks -%}
        {%- if block.type == 'space' -%}
          {%- assign sp_i = sp_i | plus: 1 -%}
          {%- assign m_cls = '' -%}
          {%- if sp_i > m_limit -%}{%- assign m_cls = ' m-hide' -%}{%- endif -%}
          <a href="{{ block.settings.link }}" class="space-card{{ m_cls }}" style="background-image:url({% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %})" {{ block.shopify_attributes }}>
            <div class="space-overlay"></div>
            <div class="space-content">
              <h3 class="space-title">{{ block.settings.title }}</h3>
              <p class="space-desc">{{ block.settings.description }}</p>
              <span class="btn-browse">{{ block.settings.button_label | default: 'Browse →' }}</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- comment -%} Blank label = no expander (same convention as brands and reviews, where it is blank on purpose). {%- endcomment -%}
    {%- if sp_total > m_limit and section.settings.more_label != blank -%}
      <div class="m-more-wrap">
        <button class="m-more" type="button" data-m-more aria-expanded="false">{{ section.settings.more_label | escape }} <span class="material-symbols-outlined">expand_more</span></button>
      </div>
    {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Lighting by Space",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Lighting by Space" },
    { "type": "text", "id": "intro", "label": "Intro line (optional)" },
    { "type": "header", "content": "Mobile" },
    { "type": "paragraph", "content": "How many space cards show on a phone before the View more button. One per row on mobile, so 2 gives two rows. Desktop always shows every card." },
    { "type": "range", "id": "mobile_limit", "label": "Cards shown on mobile", "min": 1, "max": 8, "step": 1, "default": 2 },
    { "type": "text", "id": "more_label", "label": "View more button", "default": "View more spaces" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "bg-white", "label": "White" },
        { "value": "bg-gray", "label": "Gray" }
      ],
      "default": "bg-white"
    }
  ],
  "blocks": [
    {
      "type": "space",
      "name": "Space",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "default": "space-home.png" },
        { "type": "text", "id": "title", "label": "Title", "default": "Space" },
        { "type": "text", "id": "description", "label": "Description", "default": "Description text" },
        { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Browse →" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Lighting by Space",
      "blocks": [
        { "type": "space", "settings": { "fallback": "space-home.png", "title": "Home Lighting", "description": "Comfortable lighting for every room", "link": "/collections/all" } },
        { "type": "space", "settings": { "fallback": "space-office.png", "title": "Office Lighting", "description": "Bright and productive workspaces", "link": "/collections/all" } },
        { "type": "space", "settings": { "fallback": "space-retail.png", "title": "Shop & Retail Lighting", "description": "Attract customers with great lighting", "link": "/collections/all" } },
        { "type": "space", "settings": { "fallback": "space-outdoor.png", "title": "Villa & Outdoor Lighting", "description": "Elegant exterior lighting solutions", "link": "/collections/all" } },
        { "type": "space", "settings": { "fallback": "side-banner-accent.png", "title": "Garden & Solar Lighting", "description": "Eco-friendly outdoor illumination", "link": "/collections/all" } },
        { "type": "space", "settings": { "fallback": "space-smart.png", "title": "Smart Home Lighting", "description": "Control lights from your phone", "link": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
