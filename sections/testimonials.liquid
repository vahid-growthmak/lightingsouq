{%- liquid
  assign bg = section.settings.bg
  assign initial_count = section.settings.initial_count
  assign more_link = section.settings.view_more_link
-%}
{%- style -%}
  /* .grid-4 is two columns from 0px, which is right for product cards but not for paragraphs:
     at 320px each review card got ~130px, so sentences broke to one or two words a line and the
     two columns ended at wildly different heights. Full-width cards below 640px. Scoped to this
     section by id — .grid-4 itself is shared with the product grids and must not change. */
  @media (max-width: 639px) {
    #Rev--{{ section.id }} .grid-4 { grid-template-columns: 1fr; }
  }
{%- endstyle -%}
<section class="section {{ bg }}" id="Rev--{{ section.id }}">
  <div class="container">
    <div class="text-center mb-8">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <div class="reviews-badge-center">
        {%- render 'google-reviews', rating: settings.google_rating, count: settings.google_count, link: settings.google_reviews_url -%}
      </div>
    </div>
    {%- comment -%}
      initial_count governs every breakpoint. Full-width cards on a phone made even four a long
      scroll, so mobile_count trims further below 768px and "View more" reveals the rest up to
      initial_count. Desktop still shows initial_count on load — m-hide does nothing at 768px+.
    {%- endcomment -%}
    {%- liquid
      assign m_count = section.settings.mobile_count | default: 2
      assign rev_total = 0
      for b in section.blocks
        if b.type == 'review'
          assign rev_total = rev_total | plus: 1
        endif
      endfor
      assign rev_shown = initial_count
      if rev_total < rev_shown
        assign rev_shown = rev_total
      endif
      assign rev_i = 0
    -%}
    <div data-m-collapse>
    <div class="grid-4">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign rev_i = rev_i | plus: 1 -%}
          {%- assign m_cls = '' -%}
          {%- if rev_i > m_count -%}{%- assign m_cls = ' m-hide' -%}{%- endif -%}
          <div class="review-card{% if rev_i > initial_count %} review-hidden{% endif %}{{ m_cls }}" {{ block.shopify_attributes }}>
            <div class="review-stars">{% render 'rating-stars', rating: block.settings.rating %}</div>
            <p class="review-text">{{ block.settings.text }}</p>
            <p class="reviewer-name">{{ block.settings.name }}</p>
            <p class="review-date">{{ block.settings.date }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- comment -%}
      Blank label = no expander. Deliberately blank here: the "View more reviews" link below
      already goes to the reviews page, so an expander sat directly above a near-identical control.
    {%- endcomment -%}
    {%- if rev_shown > m_count and section.settings.more_label != blank -%}
      <div class="m-more-wrap">
        <button class="m-more" type="button" data-m-more aria-expanded="false">{{ section.settings.more_label | escape }} <span class="material-symbols-outlined">expand_more</span></button>
      </div>
    {%- endif -%}
    </div>
    <div class="reviews-actions" style="justify-content:center;">
      {%- if more_link != blank -%}
        <a class="btn-view-more" href="{{ more_link }}">{{ section.settings.view_more_label }} <span class="material-symbols-outlined">arrow_forward</span></a>
      {%- else -%}
        <button class="btn-view-more" type="button" data-reviews-more>
          <span class="material-symbols-outlined">expand_more</span> {{ section.settings.view_more_label }}
        </button>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('Rev--{{ section.id }}');
    if (!root) return;
    var btn = root.querySelector('[data-reviews-more]');
    if (!btn) return;
    var hidden = root.querySelectorAll('.review-hidden');
    if (!hidden.length) {
      btn.style.display = 'none';
      return;
    }
    btn.addEventListener('click', function () {
      root.querySelectorAll('.review-hidden').forEach(function (el) {
        el.classList.remove('review-hidden');
      });
      btn.style.display = 'none';
    });
  })();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Buyers in Qatar"
    },
    {
      "type": "range",
      "id": "initial_count",
      "label": "Reviews shown before View more",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    { "type": "header", "content": "Mobile" },
    { "type": "paragraph", "content": "Cards go full width on a phone, so fewer fit comfortably. This trims the count below 768px only; the View more button reveals the rest. Desktop uses the count above." },
    { "type": "range", "id": "mobile_count", "label": "Reviews shown on mobile", "min": 1, "max": 8, "step": 1, "default": 2 },
    { "type": "text", "id": "more_label", "label": "Mobile View more button", "info": "Leave blank for no expander — the View more button below already links to the reviews page. Type a label here to add an expand button on mobile." },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "View more button label",
      "default": "View more reviews"
    },
    { "type": "url", "id": "view_more_link", "label": "\"View more\" page (e.g. Reviews page)" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "bg-white", "label": "White" },
        { "value": "bg-gray", "label": "Gray" }
      ],
      "default": "bg-white"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Customer Name" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 0.5, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text" },
        { "type": "text", "id": "date", "label": "Date" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "name": "Ahmed Al-Kuwari", "rating": 5, "text": "Great selection of lighting products. Fast delivery and excellent quality.", "date": "April 2026" } },
        { "type": "review", "settings": { "name": "Fatima Hassan", "rating": 5, "text": "Best lighting store in Qatar. WhatsApp support was very helpful.", "date": "April 2026" } },
        { "type": "review", "settings": { "name": "Mohammed Al-Thani", "rating": 5, "text": "Ordered solar lights for my garden. Very satisfied with the purchase.", "date": "March 2026" } },
        { "type": "review", "settings": { "name": "Sara Abdullah", "rating": 4, "text": "Good prices and wide variety. Delivery was on time.", "date": "March 2026" } },
