<script>
  /* "Shop Now" after login pointed at /collections/frontpage - Shopify's default
     "Home page" collection, which is empty (0 products). No theme file links there, so
     it comes from the logged-in account area or an app block; rewrite it wherever it
     appears so shoppers always land on the real catalogue. Capture phase runs before
     navigation, so it also covers links rendered after page load. */
  (function () {
    var FROM = '/collections/frontpage', TO = '/collections/all';
    function retarget(a) {
      var h = a && a.getAttribute('href');
      if (h && h.indexOf(FROM) !== -1) a.setAttribute('href', h.split(FROM).join(TO));
    }
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest && e.target.closest('a[href*="' + FROM + '"]');
      if (a) retarget(a);
    }, true);
    function sweep() { document.querySelectorAll('a[href*="' + FROM + '"]').forEach(retarget); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sweep);
    else sweep();
    window.addEventListener('load', sweep);
  })();
</script>

<script>
  /* Brand logos all look like different sizes because they are sized on different axes.
     Every logo context caps BOTH axes (marquee 44x140, tiles 44px x 80%, brand pages 100%) and
     uses object-fit: contain, so each logo is limited by whichever axis binds first: a wordmark
     hits the width cap and comes out short, a square mark hits the height cap and comes out
     narrow. Measured on the marquee, Osram covered 3.5x the area of KDK.

     Equal HEIGHT does not fix it either - at the same height a 6.5:1 wordmark reads as far bigger
     than a 1:1 mark. What the eye actually reads as "same size" is equal AREA, so each logo is
     scaled to a constant area derived from its own context's cap box. Height is clamped so a
     square mark cannot tower over a wordmark, and never past the space its container actually has.

     Runs off natural dimensions, so merchant-uploaded logos are handled too, and the CSS caps stay
     as the no-JS fallback. */
  (function () {
    var FILL = 0.52;      /* share of the cap box each logo should cover */
    var SHORTEST = 0.45;  /* a very wide wordmark may go this far under the height cap */

    function px(v) { var n = parseFloat(v); return isFinite(n) ? n : 0; }

    function size(img) {
      if (!img.naturalWidth || !img.naturalHeight) return;
      var cs = getComputedStyle(img);
      var capH = px(img.dataset.capH || cs.maxHeight);
      var capW = px(img.dataset.capW || cs.maxWidth);
      if (!capH || !capW) return;                 /* no cap box to work from - leave it alone */
      img.dataset.capH = capH; img.dataset.capW = capW;   /* remember, we are about to clear them */

      /* How far a square mark may exceed the height cap, per context. Declared in CSS as
         --logo-grow because only the stylesheet knows the container has spare room: the marquee
         card is 84px around a 44px cap, the strip tile 56px. Measuring the parent here instead
         would be circular - it auto-sizes to this very image. Default 1 means never exceed, which
         is correct where the cap is already 100% of the box (brand pages, index cards). */
      var grow = parseFloat(cs.getPropertyValue('--logo-grow')) || 1;

      var ratio = img.naturalWidth / img.naturalHeight;
      var h = Math.sqrt(capH * capW * FILL / ratio);
      h = Math.max(capH * SHORTEST, Math.min(capH * grow, h));

      var w = h * ratio;
      if (w > capW) { w = capW; h = w / ratio; }  /* width still wins for the widest wordmarks */

      img.style.maxHeight = 'none';
      img.style.maxWidth = 'none';
      img.style.height = h.toFixed(1) + 'px';
      img.style.width = w.toFixed(1) + 'px';
    }

    function run() {
      document.querySelectorAll('.brand-img').forEach(function (img) {
        if (img.complete) size(img);
        else img.addEventListener('load', function () { size(img); }, { once: true });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
    window.addEventListener('load', run);
    var t; window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(run, 150); }, { passive: true });
  })();
</script>

{%- comment -%}
  Global storefront behaviour: wishlist (localStorage), AJAX add-to-cart,
  cart drawer render from /cart.js, and toasts. Progressive enhancement —
  if JS fails, product forms still POST to /cart and links still work.
{%- endcomment -%}
<script>
(function () {
  'use strict';
  var ADD_URL = '{{ routes.cart_add_url }}.js';
  var CHANGE_URL = '{{ routes.cart_change_url }}.js';
  var CART_URL = '{{ routes.cart_url }}.js';
  var WL_KEY = 'lsq_wishlist';

  /* editable storefront strings (Theme settings › Buttons & labels) */
  var T = {
    wlSaved: {{ settings.toast_wishlist_saved | default: 'Saved to wishlist' | json }},
    wlRemoved: {{ settings.toast_wishlist_removed | default: 'Removed from wishlist' | json }},
    cartAddError: {{ settings.toast_cart_error | default: 'Could not add to cart' | json }},
    cartEmpty: {{ settings.cart_empty | default: 'Your cart is empty.' | json }},
    shopAll: {{ settings.cart_shop_all | default: 'Shop all products' | json }},
    shopAllLink: {{ settings.cart_shop_all_link | default: routes.all_products_collection_url | json }},
    subtotal: {{ settings.cart_subtotal | default: 'Subtotal' | json }},
    taxNote: {{ settings.cart_tax_note | default: 'Shipping & taxes calculated at checkout.' | json }},
    checkout: {{ settings.cart_checkout | default: 'Checkout' | json }},
    viewCart: {{ settings.cart_view | default: 'View cart' | json }},
    remove: {{ settings.label_remove | default: 'Remove' | json }},
    cartError: {{ settings.cart_error | default: 'Could not load cart.' | json }}
  };

  /* ---------- helpers ---------- */
  function money(cents, code) {
    var v = (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return (code || '{{ cart.currency.iso_code | default: shop.currency }}') + ' ' + v;
  }
  function toast(msg) {
    var t = document.querySelector('[data-toast]');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('is-visible');
    clearTimeout(t._timer);
    t._timer = setTimeout(function () { t.classList.remove('is-visible'); }, 2600);
  }

  /* ---------- wishlist ---------- */
  function wlGet() { try { return JSON.parse(localStorage.getItem(WL_KEY)) || []; } catch (e) { return []; } }
  function wlSet(arr) { localStorage.setItem(WL_KEY, JSON.stringify(arr)); wlUpdateBadge(); }
  function wlHas(handle) { return wlGet().some(function (i) { return i.handle === handle; }); }
  function wlUpdateBadge() {
    var n = wlGet().length;
    document.querySelectorAll('[data-wishlist-count]').forEach(function (el) {
      el.textContent = n; el.style.display = n > 0 ? '' : 'none';
    });
  }
  function wlToggle(btn) {
    var handle = btn.getAttribute('data-handle');
    if (!handle) return;
    var arr = wlGet();
    var idx = arr.findIndex(function (i) { return i.handle === handle; });
    if (idx > -1) { arr.splice(idx, 1); btn.classList.remove('is-active'); toast(T.wlRemoved); }
    else {
      arr.push({
        handle: handle,
        id: btn.getAttribute('data-id'),
        variant: btn.getAttribute('data-variant'),
        available: btn.getAttribute('data-available') === 'true',
        title: btn.getAttribute('data-title'),
        url: btn.getAttribute('data-url'),
        image: btn.getAttribute('data-image'),
        price: btn.getAttribute('data-price')
      });
      btn.classList.add('is-active'); toast(T.wlSaved);
    }
    wlSet(arr);
    document.dispatchEvent(new CustomEvent('wishlist:change'));
  }
  function wlMarkButtons() {
    document.querySelectorAll('[data-wishlist-toggle]').forEach(function (btn) {
      if (wlHas(btn.getAttribute('data-handle'))) btn.classList.add('is-active');
    });
  }

  /* ---------- cart ---------- */
  function openDrawer() {
    var d = document.getElementById('CartDrawer');
    if (!d) return;
    d.classList.add('is-open'); d.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden'; /* BUG_19: body is not the scroller, so locking it left the page scrollbar visible next to the drawer's */
    renderCart();
  }
  function closeDrawer() {
    var d = document.getElementById('CartDrawer');
    if (!d) return;
    d.classList.remove('is-open'); d.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = ''; /* BUG_19 */
  }
  function setCounts(n) {
    document.querySelectorAll('[data-cart-count]').forEach(function (el) { el.textContent = n; });
  }
  function itemMarkup(it, code) {
    return '<div class="cd-item" data-key="' + it.key + '">' +
      '<a class="cd-item__img" href="' + it.url + '"><img src="' + (it.image ? it.image.replace(/(\.[a-z]+)(\?|$)/i, '_120x$1$2') : '') + '" alt="" width="60" height="60" loading="lazy"></a>' +
      '<div class="cd-item__info">' +
        '<a class="cd-item__title" href="' + it.url + '">' + it.product_title + '</a>' +
        (it.variant_title ? '<p class="cd-item__variant">' + it.variant_title + '</p>' : '') +
        '<div class="cd-item__row">' +
          '<div class="cd-qty">' +
            '<button type="button" class="cd-qty__btn" data-qty-dec aria-label="Decrease">&minus;</button>' +
            '<span class="cd-qty__num">' + it.quantity + '</span>' +
            '<button type="button" class="cd-qty__btn" data-qty-inc aria-label="Increase">+</button>' +
          '</div>' +
          '<span class="cd-item__price">' + money(it.final_line_price, code) + '</span>' +
        '</div>' +
        '<button type="button" class="cd-item__remove" data-remove aria-label="' + T.remove + '" title="' + T.remove + '"><span class="material-symbols-outlined">delete</span></button>' +
      '</div></div>';
  }

  /* Repaint from a cart object. When the line-item set is unchanged (the usual case after a
     quantity step) only the numbers are patched: a full innerHTML rebuild would destroy the very
     button the shopper is tapping, which is why repeated taps used to lose their target, and it
     re-requests every thumbnail. Structural changes still rebuild. */
  function paintCart(cart) {
    var body = document.querySelector('[data-cart-body]');
    var foot = document.querySelector('[data-cart-foot]');
    if (!body) return;
    setCounts(cart.item_count);
    if (!cart.items.length) {
      body.innerHTML = '<div class="cart-drawer__empty"><span class="material-symbols-outlined">shopping_cart</span><p>' + T.cartEmpty + '</p><a class="btn-primary" href="' + T.shopAllLink + '">' + T.shopAll + '</a></div>';
      if (foot) foot.hidden = true;
      return;
    }
    var code = cart.currency;
    var rows = body.querySelectorAll('.cd-item');
    var sameShape = rows.length === cart.items.length;
    if (sameShape) {
      for (var i = 0; i < rows.length; i++) {
        if (rows[i].getAttribute('data-key') !== cart.items[i].key) { sameShape = false; break; }
      }
    }
    if (sameShape) {
      cart.items.forEach(function (it, i) {
        var row = rows[i];
        var n = row.querySelector('.cd-qty__num');
        var p = row.querySelector('.cd-item__price');
        if (n && n.textContent != it.quantity) n.textContent = it.quantity;
        if (p) p.textContent = money(it.final_line_price, code);
        row.classList.remove('is-busy');
      });
    } else {
      body.innerHTML = cart.items.map(function (it) { return itemMarkup(it, code); }).join('');
    }
    if (foot) {
      foot.hidden = false;
      foot.innerHTML = '<div class="cd-subtotal"><span>' + T.subtotal + '</span><strong>' + money(cart.total_price, code) + '</strong></div>' +
        '<p class="cd-note">' + T.taxNote + '</p>' +
        '<a class="btn-primary cd-checkout" href="/checkout">' + T.checkout + '</a>' +
        '<a class="cd-viewcart" href="{{ routes.cart_url }}">' + T.viewCart + '</a>';
    }
  }

  function renderCart() {
    var body = document.querySelector('[data-cart-body]');
    if (!body) return;
    fetch(CART_URL, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(paintCart)
      .catch(function () { body.innerHTML = '<p style="padding:1.5rem;">' + T.cartError + '</p>'; });
  }

  /* Quantity stepping.

     It used to fire /cart/change.js, wait, then fire a whole second /cart.js, wait again, and only
     then repaint — so the number sat still for two round trips before it moved. Worse, every click
     read the CURRENT DOM number, which had not updated yet: three fast taps on + all computed
     "2" and sent it three times instead of reaching 4.

     Now the number moves on the tap and the network follows. `desired` holds the target quantity
     per line, so repeated taps accumulate against the intent rather than the stale DOM. Sends are
     debounced, so a burst of taps is one request. /cart/change.js already returns the whole cart,
     so its response repaints directly and the second fetch is gone. On failure we fall back to the
     server's truth rather than leaving the optimistic number lying. */
  var desired = {};
  var flushTimer = null;
  var inFlight = false;

  function scheduleFlush() {
    clearTimeout(flushTimer);
    flushTimer = setTimeout(flushQty, 220);
  }
  function flushQty() {
    if (inFlight) { scheduleFlush(); return; }
    var keys = Object.keys(desired);
    if (!keys.length) return;
    var key = keys[0];
    var qty = desired[key];
    delete desired[key];
    inFlight = true;
    fetch(CHANGE_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        inFlight = false;
        paintCart(cart);
        if (Object.keys(desired).length) scheduleFlush();
      })
      .catch(function () { inFlight = false; desired = {}; renderCart(); });
  }
  function changeQty(key, qty) {
    var row = document.querySelector('.cd-item[data-key="' + key.replace(/"/g, '\\"') + '"]');
    desired[key] = qty;
    if (row) {
      var n = row.querySelector('.cd-qty__num');
      if (qty <= 0) row.classList.add('is-removing');
      else if (n) n.textContent = qty;
      row.classList.add('is-busy');
    }
    scheduleFlush();
  }
  /* Steps against the pending intent, not the painted number, so bursts land on the right total. */
  function stepQty(key, delta) {
    var row = document.querySelector('.cd-item[data-key="' + key.replace(/"/g, '\\"') + '"]');
    if (!row) return;
    var base = (key in desired) ? desired[key] : (parseInt(row.querySelector('.cd-qty__num').textContent, 10) || 1);
    changeQty(key, Math.max(0, base + delta));
  }

  function addToCart(form) {
    var btn = form.querySelector('[type=submit]');
    if (btn) { btn.disabled = true; btn.classList.add('is-loading'); }
    fetch(ADD_URL, {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: new FormData(form)
    }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (btn) { btn.disabled = false; btn.classList.remove('is-loading'); }
        if (!res.ok) { toast(res.d.description || T.cartAddError); return; }
        openDrawer();
      })
      .catch(function () { if (btn) { btn.disabled = false; btn.classList.remove('is-loading'); } form.submit(); });
  }

  /* ---------- delegated events ---------- */
  document.addEventListener('click', function (e) {
    /* Mobile "View more": reveal the .m-hide items in the nearest [data-m-collapse]. One handler
       serves every section that opts in, so no section ships its own copy of this. */
    var mMore = e.target.closest('[data-m-more]');
    if (mMore) {
      var mWrap = mMore.closest('[data-m-collapse]');
      if (mWrap) { mWrap.classList.add('is-expanded'); mMore.setAttribute('aria-expanded', 'true'); }
      return;
    }

    var wl = e.target.closest('[data-wishlist-toggle]');
    if (wl) { e.preventDefault(); wlToggle(wl); return; }

    if (e.target.closest('[data-cart-close]')) { closeDrawer(); return; }
    if (e.target.closest('[data-cart-open]')) { e.preventDefault(); openDrawer(); return; }

    var dec = e.target.closest('[data-qty-dec]');
    var inc = e.target.closest('[data-qty-inc]');
    var rem = e.target.closest('[data-remove]');
    var row = e.target.closest('.cd-item');
    if (row && (dec || inc || rem)) {
      var key = row.getAttribute('data-key');
      /* stepQty resolves against the pending intent; reading the painted number here was what
         made a burst of taps collapse onto the same value. */
      if (dec) stepQty(key, -1);
      else if (inc) stepQty(key, 1);
      else if (rem) changeQty(key, 0);
    }
  });

  document.addEventListener('submit', function (e) {
    var form = e.target.closest('[data-cart-form]');
    if (!form) return;
    /* let "Buy it now" / dynamic checkout submitters POST normally to checkout */
    var sub = e.submitter;
    if (sub && (sub.name === 'checkout' || sub.hasAttribute('data-buy-now'))) return;
    e.preventDefault(); addToCart(form);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeDrawer();
  });

  /* open drawer when the header cart icon is clicked (but keep /cart as fallback link) */
  document.querySelectorAll('.cart-btn').forEach(function (a) {
    a.addEventListener('click', function (e) { e.preventDefault(); openDrawer(); });
  });

  document.addEventListener('DOMContentLoaded', function () { wlMarkButtons(); wlUpdateBadge(); });
  wlMarkButtons(); wlUpdateBadge();

  /* public API for the wishlist page */
  window.LSQ = {
    wishlist: wlGet,
    wishlistSet: wlSet,
    openDrawer: openDrawer,
    toast: toast,
    addVariant: function (variantId, qty) {
      if (!variantId) return;
      fetch(ADD_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: qty || 1 })
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) { if (res.ok) openDrawer(); else toast(res.d.description || T.cartAddError); });
    }
  };
})();
</script>
