{% doc %}
  @prompt
    Add custom CSS to make the brand logos in the brand strip section appear larger. The logos should display at a minimum height of 100px and width of 200px, maintaining aspect ratio. Target image elements within the brand strip section with ID template--22772107116773__brand_strip_BNbKpK.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-logo-css-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  #template--22772107116773__brand_strip_BNbKpK img {
    min-height: {{ block.settings.logo_min_height }}px !important;
    min-width: {{ block.settings.logo_min_width }}px !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
    max-width: 100% !important;
  }

  @media screen and (max-width: 749px) {
    #template--22772107116773__brand_strip_BNbKpK img {
      min-height: {{ block.settings.logo_min_height_mobile }}px !important;
      min-width: {{ block.settings.logo_min_width_mobile }}px !important;
    }
  }
{% endstyle %}

<div class="ai-brand-logo-css-{{ ai_gen_id }}" {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "Brand logo size CSS",
  "settings": [
    {
      "type": "header",
      "content": "Desktop size"
    },
    {
      "type": "range",
      "id": "logo_min_height",
      "label": "Minimum height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_min_width",
      "label": "Minimum width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Mobile size"
    },
    {
      "type": "range",
      "id": "logo_min_height_mobile",
      "label": "Minimum height",
      "min": 40,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_min_width_mobile",
      "label": "Minimum width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Brand logo size CSS"
    }
  ]
}
{% endschema %}
